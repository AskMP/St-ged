{
  "name": "@staged/db",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "migrate": "dotenv -e ../../.env.local -- tsx src/migrate.ts",
    "generate": "drizzle-kit generate",
    "seed": "dotenv -e ../../.env.local -- tsx src/seeds/index.ts",
    "seed:recipes": "dotenv -e ../../.env.local -- tsx src/seeds/recipes.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
